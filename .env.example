# Copy to .env and adjust. Every value below has a working default in
# src/mtb_planner/config/settings.py — nothing here is required to run.

# --- paths ---------------------------------------------------------------
# Root for downloaded extracts, DEM tiles, and built artifacts.
MTB_DATA_DIR=./data
# Artifact the server loads at startup, relative to MTB_DATA_DIR/graph.
# If this one is not built and exactly one other is, that one is served
# instead; with several built and none matching, the server says so and
# refuses to guess. `mtb serve --artifact NAME` overrides it.
MTB_ARTIFACT=aoi-v1

# --- server --------------------------------------------------------------
MTB_HOST=127.0.0.1
MTB_PORT=8000
MTB_LOG_LEVEL=INFO
# Written as JSON lines when set; otherwise console only.
# MTB_LOG_FILE=./out/mtb.log

# --- routing budgets -----------------------------------------------------
# Wall-clock ceiling for a single plan request. The generator is anytime:
# on expiry it returns its best candidate so far and flags meta.truncated.
MTB_ROUTE_TIMEOUT_S=20
# Concurrent plan requests. Defaults to cpu_count - 1 when unset.
# MTB_MAX_CONCURRENT_PLANS=7
# How long a planned route stays downloadable as GPX.
MTB_ROUTE_CACHE_TTL_S=3600
MTB_ROUTE_CACHE_SIZE=256

# --- basemap -------------------------------------------------------------
# Raster tiles drawn under the trail network, for orientation: towns, water,
# road numbers. The one place this app talks to a third party.
#
# Set to an empty string to run fully offline. The map is then the plain paper
# plate the rest of the design assumes, and the content security policy
# tightens back to `self` for everything. Routing, elevation and difficulty are
# local either way; no plan request ever leaves the machine.
#
# The default tiles come from the OpenStreetMap Foundation, whose tile usage
# policy permits modest personal use but not bulk or commercial traffic:
# https://operations.osmfoundation.org/policies/tiles/
# For anything past one rider planning rides, point this at your own tiles.
MTB_BASEMAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MTB_BASEMAP_URL=

# Shown on the map. Attribution is a licence condition of the OSM data and a
# usage condition of most tile servers, so it is always displayed.
# MTB_BASEMAP_ATTRIBUTION=Basemap and trail data (c) OpenStreetMap contributors, ODbL.

# Deepest zoom the tile server publishes.
MTB_BASEMAP_MAX_ZOOM=19

# --- geospatial ----------------------------------------------------------
# Keep pyproj fully offline; WGS84 -> UTM31N needs no transformation grids.
PROJ_NETWORK=OFF

# --- trail running -------------------------------------------------------
# `trail` reads the same settings under the TRAIL_ prefix. Only what differs
# from the bike needs setting; the rest defaults as above. Extracts and DEM
# tiles are shared, so point TRAIL_DATA_DIR at the same place as MTB_DATA_DIR.
# TRAIL_DATA_DIR=./data
# Built graphs live apart from the bike's, so one artifact name can exist for
# both sports without either overwriting the other.
# TRAIL_GRAPH_SUBDIR=graph-trail
# TRAIL_ARTIFACT=aoi-v1
# The next port up, so both servers run side by side.
# TRAIL_PORT=8001
# TRAIL_BASEMAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
